# /etc/systemd/system/mm-update.timer (deploy/setup-mm-record.sh が配置する)
# 1 分ごとに更新を見に行く (前の回が終わってから 1 分後。重なっては動かない)
[Unit]
Description=trade-bot-factory: update check every minute for the market making recorder

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
